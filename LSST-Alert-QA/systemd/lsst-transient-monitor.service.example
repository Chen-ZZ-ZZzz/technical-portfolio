# Rename to lsst-transient-monitor.service and replace __PROJECT_ROOT__ with your path

[Unit]
Description=Transient monitor: daily new-transient scan of the live footprint

[Service]
Type=oneshot
SyslogIdentifier=lsst-transient-monitor
ExecStartPre=/usr/bin/nm-online -q -t 36
WorkingDirectory=__PROJECT_ROOT__
Environment=PYTHONUNBUFFERED=1
Environment=UV_NO_SYNC=1
Environment=PYTHONPYCACHEPREFIX=__PROJECT_ROOT__/cache/pycache
# No arguments: never --init, never --dry-run.
ExecStart=%h/.local/bin/uv run python -m rubin_qa.transient_monitor
TimeoutStartSec=2h

# hardening — see "Sandboxing" in README.md before editing.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=__PROJECT_ROOT__/state __PROJECT_ROOT__/cache __PROJECT_ROOT__/reports
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallFilter=~@resources @privileged @keyring
SystemCallErrorNumber=EPERM
