# Rename to lsst-transient-monitor.service and replace /path/to/dir/ with your path

[Unit]
Description=Transient monitor: daily new-transient scan of the live footprint

[Service]
Type=oneshot
SyslogIdentifier=lsst-transient-monitor
ExecStartPre=/usr/bin/nm-online -q -t 36
WorkingDirectory=/path/to/LSST-Alert-QA/
Environment=PYTHONUNBUFFERED=1
# No arguments: never --init, never --dry-run.
ExecStart=/path/to/uv run python -m rubin_qa.transient_monitor
TimeoutStartSec=2h

# hardening — see "Sandboxing" in README.md before editing.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/path/to/LSST-Alert-QA/
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallFilter=~@resources @privileged @keyring
SystemCallErrorNumber=EPERM
