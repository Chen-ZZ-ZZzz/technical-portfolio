# Rename to lsst-pipeline-alerce.service and replace __PROJECT_ROOT__ with your path

[Unit]
Description=LSST-Alert-QA ALeRCE pipeline

[Service]
Type=oneshot
SyslogIdentifier=lsst-pipeline-alerce
ExecStartPre=/usr/bin/nm-online -q -t 36
WorkingDirectory=__PROJECT_ROOT__
Environment=PYTHONUNBUFFERED=1
Environment=UV_NO_SYNC=1
Environment=PYTHONPYCACHEPREFIX=__PROJECT_ROOT__/cache/pycache
ExecStart=%h/.local/bin/uv run pipeline.py lsst 196 -q
TimeoutStartSec=20min

# hardening — see "Sandboxing" in README.md before editing.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=__PROJECT_ROOT__/cache __PROJECT_ROOT__/reports
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallFilter=~@resources @privileged @keyring
SystemCallErrorNumber=EPERM
