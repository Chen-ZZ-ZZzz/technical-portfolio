# Rename to lsst-pipeline-alerce.service and replace /path/to/dir/ with your path

[Unit]
Description=LSST-Alert-QA ALeRcE pipeline

[Service]
Type=oneshot
SyslogIdentifier=lsst-pipeline-alerce
ExecStartPre=/usr/bin/nm-online -q -t 36
WorkingDirectory=/path/to/LSST-Alert-QA
Environment=PYTHONUNBUFFERED=1
Environment=UV_NO_SYNC=1
Environment=PYTHONPYCACHEPREFIX=/path/to/LSST-Alert-QA/cache/pycache
ExecStart=%h/.local/bin/uv run pipeline.py lsst 256 -q
TimeoutStartSec=20min

# hardening — see "Sandboxing" in README.md before editing.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/path/to/LSST-Alert-QA/cache /path/to/LSST-Alert-QA/reports
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallFilter=~@resources @privileged @keyring
SystemCallErrorNumber=EPERM
